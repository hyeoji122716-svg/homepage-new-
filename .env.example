# ── Supabase ──────────────────────────────────────────────
# Supabase 대시보드 > Project Settings > Data API 에서 확인
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
# Project Settings > API Keys > service_role (secret) — 절대 외부 노출 금지
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ── 관리자 페이지 ──────────────────────────────────────────
# /admin 로그인 비밀번호. 원하는 값으로 설정하세요.
ADMIN_PASSWORD=change-me-please

# ── 문의 알림 메일 (Gmail 앱 비밀번호 방식) ────────────────
GMAIL_USER=your@gmail.com
# Google 계정 > 보안 > 2단계 인증 > 앱 비밀번호 (16자리)
GMAIL_APP_PASSWORD=xxxxxxxxxxxxxxxx
INQUIRY_NOTIFY_TO=your@naver.com

# ── 크론(배치) 인증 ────────────────────────────────────────
# 임의의 긴 랜덤 문자열 (예: openssl rand -hex 32)
CRON_SECRET=your-random-secret

# ── 예약 페이지 비밀 URL ───────────────────────────────────
# 예약 화면 접근용 UUID. 이 값이 /reserve/<값> 경로가 된다.
# 생성 예: node -e "console.log(crypto.randomUUID())"
# ⚠️ 진짜 보안은 아님(URL 아는 사람은 누구나 접근). "아는 사람만" 수준의 장치.
BOOKING_ACCESS_TOKEN=00000000-0000-0000-0000-000000000000

# ── 예약 규칙 ──────────────────────────────────────────────
# 하루에 받을 유효 예약(취소 안 된 건) 상한. 미설정 시 4.
# 이 수에 도달하면 그날 남은 슬롯은 전부 예약 불가가 된다(취소하면 자동 재오픈).
DAILY_BOOKING_LIMIT=4

# ── 예약 변경·취소 안내 연락처 ─────────────────────────────
# 고객사 셀프 취소가 없으므로, /booking/<토큰> 조회 페이지에 이 연락처를 안내한다.
BOOKING_CONTACT_NAME=커넥트유 담당자
BOOKING_CONTACT_PHONE=010-0000-0000
# 미설정 시 INQUIRY_NOTIFY_TO 를 쓴다.
BOOKING_CONTACT_EMAIL=
BOOKING_CONTACT_HOURS=평일 10:00 ~ 18:00

# ── 사이트 기본 주소 ───────────────────────────────────────
# 예약 완료 화면의 "예약 확인 주소"를 도메인까지 붙여 보여줄 때 쓴다.
# 끝에 / 없이. 미설정 시 요청 헤더(host)로 자동 판단한다.
# 예: https://connectu.co.kr
NEXT_PUBLIC_SITE_URL=

# ── 예약 마감(리드타임) ────────────────────────────────────
# 컨설팅 시작 몇 시간 전까지 예약을 받을지. 미설정 시 24.
# 예) 24 → 9/1 14:00 슬롯은 8/31 14:00 을 넘기면 예약 불가.
# 0 이면 시작 시각 직전까지 받는다. 모든 판정은 Asia/Seoul 기준.
# ⚠️ 관리자 대리 등록(/api/admin/bookings/create)에는 적용되지 않는다.
BOOKING_LEAD_TIME_HOURS=24
