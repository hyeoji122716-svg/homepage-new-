# ── Supabase ──────────────────────────────────────────────
# Supabase 대시보드 > Project Settings > Data API 에서 확인
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
# Project Settings > API Keys > service_role (secret) — 절대 외부 노출 금지
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ── 관리자 페이지 ──────────────────────────────────────────
# /admin 로그인 비밀번호. 원하는 값으로 설정하세요.
ADMIN_PASSWORD=change-me-please

# ── 문의 알림 메일 (Gmail 앱 비밀번호 방식) ────────────────
GMAIL_USER=your@gmail.com
# Google 계정 > 보안 > 2단계 인증 > 앱 비밀번호 (16자리)
GMAIL_APP_PASSWORD=xxxxxxxxxxxxxxxx
INQUIRY_NOTIFY_TO=your@naver.com

# ── 크론(배치) 인증 ────────────────────────────────────────
# 임의의 긴 랜덤 문자열 (예: openssl rand -hex 32)
CRON_SECRET=your-random-secret

# ── 예약 페이지 비밀 URL ───────────────────────────────────
# 예약 화면 접근용 UUID. 이 값이 /reserve/<값> 경로가 된다.
# 생성 예: node -e "console.log(crypto.randomUUID())"
# ⚠️ 진짜 보안은 아님(URL 아는 사람은 누구나 접근). "아는 사람만" 수준의 장치.
BOOKING_ACCESS_TOKEN=00000000-0000-0000-0000-000000000000
